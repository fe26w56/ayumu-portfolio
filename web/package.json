{
  "name": "@ayumu-portfolio/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:stitch-css": "tailwindcss -c tailwind.config.cjs -i src/stitch-input.css -o src/prototype.css --minify",
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "predev": "npm run check:runtime && npm run build:stitch-css",
    "dev": "vite",
    "prebuild": "npm run check:runtime && npm run build:stitch-css",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
